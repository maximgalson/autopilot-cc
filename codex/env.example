# Autopilot for Codex — secrets file
# Copy to ~/.codex/autopilot/.env and chmod 600.
# Lines starting with # are ignored. KEY=VALUE format, no shell expansion.

# Notion sync (optional). Required if notion_sync.enabled=true in config.json.
# NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# LightRAG (optional). Used by session digest insert.
# LIGHTRAG_URL=http://localhost:9621
# LIGHTRAG_USER=admin
# LIGHTRAG_PASS=

# WIKI_DIR override (optional). Defaults to ~/claudecode/wiki if present.
# WIKI_DIR=/Users/you/claudecode/wiki
